    "title": "características",
    "variables": {
      "title": "variables",
      "description": "huecos posicionales como $$0 y $$1. misma cadena, cualquier orden, cualquier idioma.",
      "example": "[soywig]($0) está escuchando **$1** de $2",
      "codeExample": [
        "\"escuchando\": \"\\[soywig\\]\\($$0\\) está escuchando \\*\\*$$1\\*\\* de $$2\"",
        "t.escuchando(\"user/soywig\", \"The Happy Dictator (feat. Sparks), \"Gorillaz\")"
      ]
    },
    "plurals": {
      "title": "plurales",
      "description": "los idiomas con reglas más específicas funcionan sin complicaciones.",
      "example": {
        "$0": {
          "one": "hace $0 minuto",
          "other": "hace $0 minutos"
        }
      },
      "codeExample": [
        "&#123;\n&nbsp;&nbsp;\"$$0\": &#123;\n&nbsp;&nbsp;&nbsp;&nbsp;\"one\": \"hace $$0 minuto\",\n&nbsp;&nbsp;&nbsp;&nbsp;\"other\": \"hace $$0 minutos\"\n&nbsp;&nbsp;&#125;\n&#125;",
        "t.minutesAgo(0)\nt.minutesAgo(1)\nt.minutesAgo(5)\nt.minutesAgo(24)"
      ]
    },
    "tinyMarkdown": {
      "title": "mini markdown",
      "description": "soporta múltiples características de markdown. cursiva, negrita y enlaces. personalízalas desde tu css.",
      "example": "*cursiva*, **negrita**, _cursiva otra vez_, __negrita otra vez__ y un [enlace]($0).",
      "codeExample": "\\*cursiva\\*, \\*\\*negrita\\*\\*, \\_cursiva otra vez\\_, \\_\\_negrita otra vez\\_\\_, y un \\[enlace\\]\\(https://astro.build\\)"
    },
